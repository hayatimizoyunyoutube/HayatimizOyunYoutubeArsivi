{
  "version": 2,
  "framework": null,
  "installCommand": "node -e \"console.log('v2.1.8 FIX: npm install atlandi, build hizli calisacak')\"",
  "buildCommand": "node --no-warnings scripts/vercel-static-build-check.mjs",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/index.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "X-Hayatimiz-Oyun-Fix", "value": "v2.1.8-FIX-VERCEL-BUILDING-TAKILMA" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
