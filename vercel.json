{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --no-audit --no-fund",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 10
    }
  }
}
