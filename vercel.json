"routes": [
  {
    "src": "/api",
    "dest": "/api/index.js"
  },
  {
    "src": "/api/(.*)",
    "dest": "/api/index.js"
  },
  {
    "src": "/assets/(.*)",
    "dest": "/assets/$1"
  },
  {
    "src": "/data/(.*)",
    "dest": "/data/$1"
  },
  {
    "src": "/robots.txt",
    "dest": "/robots.txt"
  },
  {
    "src": "/sitemap.xml",
    "dest": "/sitemap.xml"
  },
  {
    "src": "/(.*)",
    "dest": "/index.html"
  }
]