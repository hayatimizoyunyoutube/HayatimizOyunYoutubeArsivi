{
  "version": 2,
  "installCommand": "echo HIZLI_DEPLOY: npm install atlandi, hazir dist kullaniliyor",
  "buildCommand": "echo HIZLI_DEPLOY: build atlandi, hazir dist kullaniliyor",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "X-Hayatimiz-Oyun-Deploy", "value": "v2.4.0-FIX-1-HIZLI-PREBUILT" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
